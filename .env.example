# Copy to .env for local, or to /opt/sales-manager/.env on Contabo.
# Never commit real credentials.

# ----- Local -----
NODE_ENV=development
PORT=5000
FRONTEND_PORT=5173
LOG_LEVEL=info
AI_PROVIDER=openai
APP_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
APP_BASE_PATH=/
BASE_PATH=/
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/salesmanager
SKIP_SQL_MIGRATIONS=true
SESSION_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SEED_EMAIL=nadeem.mohammed@deffinity.com
SEED_PASSWORD=CloserApp2026!
SEED_NAME=Nadeem
RESEND_API_KEY=
RESEND_FROM=Sales Manager <noreply@creativecloud.ai>
RESEND_WEBHOOK_SECRET=
STORAGE_DRIVER=local
STORAGE_ROOT=./data
PRIVATE_OBJECT_DIR=/salesmanager/private
PUBLIC_OBJECT_SEARCH_PATHS=/salesmanager/public
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

