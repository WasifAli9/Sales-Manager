{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps --env-file=../../.env ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test src/lib/validateScheduledFor.test.ts src/lib/validateCampaignLaunch.test.ts src/lib/socialScheduleHelpers.test.ts src/lib/strategyDocument.test.ts src/routes/generateScheduleForProduct.test.ts src/lib/importApolloHelpers.test.ts && node ./testTagAudience.mjs && node ./testOutreachSafety.mjs",
    "test:social": "node --experimental-strip-types --test src/lib/socialScheduleHelpers.test.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@simplewebauthn/server": "^13.3.2",
    "@types/multer": "^2.2.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-anthropic-ai": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "openai": "^6.49.0",
    "openid-client": "^6.8.4",
    "pdfkit": "^0.20.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "resend": "^6.18.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
